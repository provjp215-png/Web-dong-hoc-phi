# Sao chép file này thành .env rồi điền thông tin (không bắt buộc – để trống vẫn chạy demo được)

SECRET_KEY=doi-chuoi-bi-mat-nay
BASE_URL=http://127.0.0.1:5000
SCHOOL_NAME=Trường Đại học Việt Nhật – ĐHQGHN
SCHOOL_EN=VNU Vietnam Japan University
SCHOOL_SHORT=VJU
# 1 = hiện nhãn DEMO (đồ án môn học)
DEMO=1

# Liên hệ hỗ trợ hiển thị ở trang đăng nhập / quên mật khẩu (điền thông tin thật của phòng ban)
SUPPORT_OFFICE=Phòng Đào tạo / Phòng Kế hoạch – Tài chính
SUPPORT_EMAIL=hotro.hocphi@demo.local
SUPPORT_PHONE=024 0000 0000
SUPPORT_HOURS=Thứ 2 – Thứ 6, 8:00 – 17:00
SUPPORT_LOCATION=Cơ sở Mỹ Đình, đường Lưu Hữu Phước, Nam Từ Liêm, Hà Nội

# Nghiệp vụ
LATE_FEE_RATE_PER_DAY=0.0005
LATE_FEE_MAX_RATE=0.10
REMIND_BEFORE_DAYS=7

# VNPay sandbox – đăng ký miễn phí tại https://sandbox.vnpayment.vn/devreg/
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# Tài khoản nhận tiền VietQR (BANK_ID là mã BIN ngân hàng, VD 970436 = Vietcombank, 970422 = MB)
BANK_ID=970436
BANK_NAME=Vietcombank
BANK_ACCOUNT_NO=0011001234567
BANK_ACCOUNT_NAME=TAI KHOAN DEMO DO AN
BANK_WEBHOOK_TOKEN=demo-webhook-token

# Email nhắc hạn (Gmail: bật xác minh 2 bước rồi tạo "Mật khẩu ứng dụng")
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
